# 环境变量配置模板
# 复制此文件为 .env.development（开发）或 .env.production（生产）后修改

# API 基础地址（必填）
# 开发：本地网关地址（分享链接 OG 也走此地址）
# 生产：真实后端地址，如 https://api.example.com
REACT_APP_BASE_URL=http://localhost:8080

# 可选：分享外链根地址（默认同 REACT_APP_BASE_URL）
# 生产若网关与站点同域可设为 https://你的域名.com
# REACT_APP_SHARE_BASE_URL=https://你的域名.com

# false = 走真实后端（开发建议 REACT_APP_BASE_URL 留空，走 devServer 代理）
# true = 本地 mock
REACT_APP_ENABLE_MOCK=false

# 开发环境留空，请求走同源代理（见 craco.config.js），refresh Cookie 才稳定
# REACT_APP_BASE_URL=
