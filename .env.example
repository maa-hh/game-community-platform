# ============================================================
# 游戏社区平台 - 生产环境变量模板
# 复制为项目根目录 .env 后填写真实值，再执行 ./scripts/prod/start.sh
# ============================================================

# ---------- 运行 profile ----------
SPRING_PROFILES_ACTIVE=prod

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=game_community
MYSQL_USER=root
MYSQL_PASSWORD=请修改

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6380

# ---------- Gateway -> service 内部鉴权 ----------
GATEWAY_INTERNAL_SECRET=请生成32位以上随机串-gateway-internal

# ---------- Social 内部 Feign ----------
# content-service -> social-service Feed 投递鉴权（必须使用独立随机密钥）
SOCIAL_INTERNAL_TOKEN=请生成32位以上随机串-social-internal

# ---------- Nacos ----------
NACOS_ADDR=localhost:8848
NACOS_DISCOVERY_IP=127.0.0.1

# ---------- JWT（必须修改！各 ≥32 位随机字符串，gateway 与 user-service 保持一致）----------
JWT_ACCESS_SECRET=请生成32位以上随机串-access
JWT_REFRESH_SECRET=请生成32位以上随机串-refresh

# ---------- 网关 CORS（前端域名，多个用逗号分隔）----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# ---------- 邮箱 SMTP（生产必须配置，mock 已关闭）----------
# QQ 邮箱示例：host=smtp.qq.com, port=587, password=邮箱设置里生成的授权码
EMAIL_MOCK_ENABLED=false
EMAIL_MX_CHECK_ENABLED=true
# 验证码有效期（秒）：Redis TTL / expireIn / 邮件文案共用，默认 300
EMAIL_CODE_EXPIRE_SECONDS=300
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=你的QQ号@qq.com
SMTP_PASSWORD=QQ邮箱SMTP授权码
SMTP_FROM=你的QQ号@qq.com
SMTP_STARTTLS=true

# ---------- 认证 ----------
AUTH_SEED_ENABLED=false
AUTH_COOKIE_SECURE=true

# ---------- 可选：AI / MinIO / 审核 ----------
# DASHSCOPE_API_KEY=（仅用于现有 Embedding；DeepSeek 当前不提供兼容的 Embedding 模型）
# DeepSeek 文本/图片审核（官方 OpenAI 兼容 API）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CHAT_MODEL=deepseek-flash
# DEEPSEEK_TEXT_MODEL=deepseek-flash
# DEEPSEEK_IMAGE_MODEL=deepseek-flash
# MINIO_ENDPOINT=http://localhost:9000
# MinIO HTTP 并发连接池（分片上传默认每文件 4 路，服务端最多 16 路同主机请求）
# MINIO_MAX_REQUESTS=64
# MINIO_MAX_REQUESTS_PER_HOST=16
# MINIO_MAX_IDLE_CONNECTIONS=32
# MINIO_KEEP_ALIVE_MINUTES=5
# CONTENT_FILE_UPLOAD_CONCURRENCY=8
# AUDIT_MODE=llm
# AI_DEFAULT_PROVIDER=deepseek
# 兼容旧变量：AUDIT_DASHSCOPE_TEXT_MODEL / AUDIT_DASHSCOPE_IMAGE_MODEL
# AUDIT_REJECT_MAX_SCORE=3
# AUDIT_HUMAN_REVIEW_MAX_SCORE=6
# AUDIT_UNAVAILABLE_DECISION=HUMAN_REVIEW
# AUDIT_MAX_TEXT_CHARS=12000
# AUDIT_MAX_CONCURRENT_MODEL_CALLS=8
# AUDIT_SENSITIVE_WORDS_PATH=classpath:moderation/sensitive-words.txt

# ---------- Steam（Web API Key 仅后端使用，勿提交到 Git）----------
# STEAM_WEB_API_KEY=
# STEAM_OPENID_REALM=http://localhost:8080
# STEAM_OPENID_RETURN_TO=http://localhost:8080/steam/callback
# STEAM_API_LANG=schinese
# STEAM_API_CC=cn
# STEAM_FRONTEND_REDIRECT=http://localhost:3000/profile
